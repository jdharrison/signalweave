# This file contains development-only examples, not credentials.
# Copy to .env when the server crate is introduced in Milestone 2.
WOVEN_ENV=development
WOVEN_BIND_ADDRESS=127.0.0.1:8080
WOVEN_AUTH_PROVIDER=development
WOVEN_DEV_AUTH_TOKEN=replace-with-a-local-only-token
WOVEN_ALLOWED_ORIGINS=http://localhost:5173
WOVEN_MAX_FRAME_BYTES=65536
WOVEN_MAX_PAYLOAD_BYTES=65536
WOVEN_TOTAL_QUEUE_CAPACITY=512
WOVEN_CRITICAL_QUEUE_CAPACITY=256
WOVEN_LATEST_QUEUE_CAPACITY=512
WOVEN_BEST_EFFORT_QUEUE_CAPACITY=128
WOVEN_INFERENCE_ENABLED=false
