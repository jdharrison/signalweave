# This file contains development-only examples, not credentials.
# Copy to .env when the server crate is introduced in Milestone 2.
SIGNALWEAVE_ENV=development
SIGNALWEAVE_BIND_ADDRESS=127.0.0.1:8080
SIGNALWEAVE_AUTH_PROVIDER=development
SIGNALWEAVE_DEV_AUTH_TOKEN=replace-with-a-local-only-token
SIGNALWEAVE_ALLOWED_ORIGINS=http://localhost:5173
SIGNALWEAVE_MAX_FRAME_BYTES=65536
SIGNALWEAVE_MAX_PAYLOAD_BYTES=65536
SIGNALWEAVE_TOTAL_QUEUE_CAPACITY=512
SIGNALWEAVE_CRITICAL_QUEUE_CAPACITY=256
SIGNALWEAVE_LATEST_QUEUE_CAPACITY=512
SIGNALWEAVE_BEST_EFFORT_QUEUE_CAPACITY=128
SIGNALWEAVE_INFERENCE_ENABLED=false
